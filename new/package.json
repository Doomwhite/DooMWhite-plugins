{
  "name": "pnpm-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "*": "pnpm --filter=*",
    "common": "pnpm --filter common",
    "common:watch": "pnpm common watch",
    "plugin-a": "pnpm --filter plugin-a",
    "plugin-a:watch": "pnpm --filter plugin-a watch",
    "dailynotes": "pnpm --filter daily-notes",
    "dailynotes:watch": "pnpm --filter daily-notes watch",
    "watch": "concurrently --kill-others-on-fail --names \"common,plugin-a,dailynotes\" \"pnpm common:watch\" \"pnpm plugin-a:watch\" \"pnpm dailynotes:watch\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  }
}
